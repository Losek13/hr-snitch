{
  "manifest_version": 3,
  "name": "Donosiciel - Opinie o procesach rekrutacji",
  "version": "1.0",
  "description": "Sieciowe opinie o procesach rekrutacji na pracuj.pl - od aplikujących dla aplikujących. Rozkład jazdy znany.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "donosiciel-opinie@projekt.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*.pracuj.pl/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pracuj.pl/*"
      ],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
