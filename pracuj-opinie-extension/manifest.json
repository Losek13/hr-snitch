{
  "manifest_version": 3,
  "name": "Donosiciel - Opinie o procesach rekrutacji",
  "version": "2.5",
  "description": "Opinie użytkowników o procesach rekrutacji na pracuj.pl - od aplikujących dla aplikujących.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*.pracuj.pl/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pracuj.pl/*"
      ],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
