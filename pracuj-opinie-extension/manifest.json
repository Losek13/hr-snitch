{
  "manifest_version": 3,
  "name": "Pracuj.pl - Opinie o rekrutacji",
  "version": "2.5",
  "description": "Sieciowe opinie o rekrutacji na pracuj.pl z filtrem wulgaryzmów",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*.pracuj.pl/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pracuj.pl/*"
      ],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
